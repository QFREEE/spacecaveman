{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spacecaveman",
  "workers_dev": true,
  "routes": [
    { "pattern": "spacecaveman.com", "custom_domain": true }
  ],
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
